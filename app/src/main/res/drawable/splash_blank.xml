<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+'s own start screen: no icon, just the background colour, so Viewarr's animated splash (ui/common/Splash.kt)
     starts cleanly on the same colour (a still logo first, then the animation sliding in, was a visible jump). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <size android:width="1dp" android:height="1dp" />
</shape>
